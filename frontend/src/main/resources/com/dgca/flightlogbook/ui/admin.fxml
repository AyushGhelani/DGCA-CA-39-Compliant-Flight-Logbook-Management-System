<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dgca.flightlogbook.ui.controller.AdminController"
      prefWidth="950" prefHeight="650" spacing="10">

    <!-- Top Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
        <Label text="DGCA Flight Logbook" styleClass="top-bar-title"/>
        <Label text="Admin Portal" style="-fx-text-fill: #90cdf4; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="adminNameLabel" text="Administrator" styleClass="top-bar-user"/>
        <Button text="Logout" styleClass="btn-logout" onAction="#handleLogout"/>
    </HBox>

    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>

        <!-- Form: Add Aircraft -->
        <VBox spacing="10" styleClass="card-pane">
            <Label text="Register New Aircraft" styleClass="header-title"/>
            <Separator/>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Tail Registration:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="regTailField" promptText="e.g. VT-AAA" prefWidth="180"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Type Designator:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="typeDesignatorField" promptText="e.g. C172" prefWidth="150"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Engine Type:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="engineTypeComboBox" prefWidth="180"/>
                </VBox>

                <VBox spacing="5" alignment="BOTTOM_LEFT">
                    <Label text=""/>
                    <Button fx:id="addAircraftButton" text="Add Aircraft" onAction="#handleAddAircraft"
                            styleClass="btn-success" style="-fx-padding: 7 20 7 20;"/>
                </VBox>
            </HBox>

            <Label fx:id="formStatusLabel" styleClass="error-label" visible="false"/>
        </VBox>

        <!-- Table: Existing Aircraft -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Fleet &amp; Aircraft Registry" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh Fleet" onAction="#loadAircraftList" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="aircraftTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colTail" text="Tail Registration" prefWidth="220"/>
                    <TableColumn fx:id="colType" text="Type Designator" prefWidth="200"/>
                    <TableColumn fx:id="colEngine" text="Engine Type" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
